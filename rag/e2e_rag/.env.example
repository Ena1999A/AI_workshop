# Postgres connection string for a Neon project with the pgvector extension
# available (Neon supports pgvector on all plans). Find this in your Neon
# project dashboard under "Connection Details".
DATABASE_URL=postgresql://user:password@your-project.neon.tech/dbname?sslmode=require

# LLM provider to use in 02_chatbot.py: "gemini" or "claude"
LLM_PROVIDER=gemini

# API keys — only the one matching LLM_PROVIDER is required, but both can be set
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: override the default model for each provider
GEMINI_MODEL=gemini-2.5-flash-lite
CLAUDE_MODEL=claude-haiku-4-5
